rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function validRoutine() {
      return request.resource.data.nome is string
        && request.resource.data.nome.size() >= 1
        && request.resource.data.nome.size() <= 80
        && request.resource.data.exercicios is list
        && request.resource.data.exercicios.size() <= 60;
    }

    function validWeight() {
      return request.resource.data.pesoKg is number
        && request.resource.data.pesoKg >= 20
        && request.resource.data.pesoKg <= 400;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /treinos/{treinoId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && validRoutine();
      allow update: if ownsExisting()
        && ownsNew()
        && validRoutine();
    }

    match /sessoes/{sessaoId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew()
        && request.resource.data.nomeRotina is string
        && request.resource.data.nomeRotina.size() <= 80
        && request.resource.data.exercicios is list
        && request.resource.data.exercicios.size() <= 60;
      // Sessões concluídas são histórico: não podem ser alteradas pelo cliente.
      allow update: if false;
    }

    match /pesos/{pesoId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && validWeight();
      allow update: if ownsExisting() && ownsNew() && validWeight();
    }

    match /dietas/{dietaId} {
      allow read, delete: if ownsExisting() && dietaId == request.auth.uid;
      allow create: if ownsNew() && dietaId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'refeicoes', 'atualizadoEm'])
        && request.resource.data.refeicoes is list
        && request.resource.data.refeicoes.size() <= 12;
      allow update: if ownsExisting() && ownsNew() && dietaId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'refeicoes', 'atualizadoEm'])
        && request.resource.data.refeicoes is list
        && request.resource.data.refeicoes.size() <= 12;
    }
  }
}
