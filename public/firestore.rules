rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function prepPartners(first, second) {
      return first is string && second is string && first != second
        && exists(/databases/$(database)/documents/mealShares/$(first))
        && exists(/databases/$(database)/documents/mealShares/$(second))
        && get(/databases/$(database)/documents/mealShares/$(first)).data.partnerId == second
        && get(/databases/$(database)/documents/mealShares/$(second)).data.partnerId == first;
    }

    match /users/{userId}/customFoods/{foodId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['nome', 'kcal100', 'proteina100', 'carbo100', 'gordura100', 'yieldFactor', 'yieldConfirmed'])
        && request.resource.data.keys().hasOnly(['nome', 'kcal100', 'proteina100', 'carbo100', 'gordura100', 'yieldFactor', 'yieldConfirmed'])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 80
        && request.resource.data.kcal100 is number && request.resource.data.kcal100 >= 0 && request.resource.data.kcal100 <= 1000
        && request.resource.data.proteina100 is number && request.resource.data.proteina100 >= 0 && request.resource.data.proteina100 <= 100
        && request.resource.data.carbo100 is number && request.resource.data.carbo100 >= 0 && request.resource.data.carbo100 <= 100
        && request.resource.data.gordura100 is number && request.resource.data.gordura100 >= 0 && request.resource.data.gordura100 <= 100
        && request.resource.data.yieldFactor is number && request.resource.data.yieldFactor > 0 && request.resource.data.yieldFactor <= 10
        && request.resource.data.yieldConfirmed is bool;
    }

    match /mealShares/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || resource.data.partnerId == request.auth.uid);
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['partnerId', 'name'])
        && request.resource.data.partnerId is string && request.resource.data.partnerId.size() <= 128
        && request.resource.data.partnerId != userId
        && request.resource.data.name is string && request.resource.data.name.size() <= 100;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /mealInvites/{code} {
      // Codes are random 128-bit capabilities; listing invitations is forbidden.
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'guestId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 100
        && request.resource.data.guestId == null && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerId != request.auth.uid
        && resource.data.createdAt > request.time - duration.value(2, 'd')
        && resource.data.guestId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestId'])
        && request.resource.data.guestId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /mealPreparations/{preparationId} {
      // Already shared history remains available to its two original participants.
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.partnerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'partnerId', 'title', 'preparedOn', 'ingredients', 'preparation', 'notes', 'rating', 'createdAt'])
        && (request.resource.data.partnerId == null || prepPartners(request.auth.uid, request.resource.data.partnerId))
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.preparedOn is string && request.resource.data.preparedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500))
        && (!('rating' in request.resource.data) || request.resource.data.rating in ['', 'favorite', 'ok', 'avoid'])
        && request.resource.data.ingredients is list && request.resource.data.ingredients.size() > 0 && request.resource.data.ingredients.size() <= 20
        && request.resource.data.preparation is map
        && request.resource.data.preparation.pots is list && request.resource.data.preparation.pots.size() > 0 && request.resource.data.preparation.pots.size() <= 56
        && request.resource.data.preparation.batch is list && request.resource.data.preparation.batch.size() <= 20
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'chrisouzamol@gmail.com';
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function userProfileFields() {
      return [
        'name', 'email', 'photoURL', 'createdAt',
        'dailyCalorieGoal', 'metaCalorias', 'macroGoals',
        'metaSemanal', 'alturaCm', 'metaPesoKg', 'objetivo',
        'preferenciasAcessibilidade', 'dashboardCards', 'dashboardCardsUpdatedAt',
        'exerciseLibraryPreferences', 'medidasHistorico', 'fotosProgresso',
        'unidadePeso', 'perfilPrivado', 'compartilharEstatisticas', 'appModules',
        'avatarFrame'
      ];
    }


    function validMacroGoals() {
      return !('macroGoals' in request.resource.data)
        || (request.resource.data.macroGoals is map
          && request.resource.data.macroGoals.keys().hasOnly(['protein', 'carbs', 'fat'])
          && (!('protein' in request.resource.data.macroGoals) || (request.resource.data.macroGoals.protein is number && request.resource.data.macroGoals.protein >= 0 && request.resource.data.macroGoals.protein <= 600))
          && (!('carbs' in request.resource.data.macroGoals) || (request.resource.data.macroGoals.carbs is number && request.resource.data.macroGoals.carbs >= 0 && request.resource.data.macroGoals.carbs <= 1200))
          && (!('fat' in request.resource.data.macroGoals) || (request.resource.data.macroGoals.fat is number && request.resource.data.macroGoals.fat >= 0 && request.resource.data.macroGoals.fat <= 400)));
    }

    function validAccessibilityPreferences() {
      return !('preferenciasAcessibilidade' in request.resource.data)
        || (request.resource.data.preferenciasAcessibilidade is map
          && request.resource.data.preferenciasAcessibilidade.keys().hasOnly(['theme', 'contrast', 'largeText', 'reduceMotion', 'language'])
          && (!('theme' in request.resource.data.preferenciasAcessibilidade) || request.resource.data.preferenciasAcessibilidade.theme in ['system', 'dark', 'light'])
          && (!('contrast' in request.resource.data.preferenciasAcessibilidade) || request.resource.data.preferenciasAcessibilidade.contrast is bool)
          && (!('largeText' in request.resource.data.preferenciasAcessibilidade) || request.resource.data.preferenciasAcessibilidade.largeText is bool)
          && (!('reduceMotion' in request.resource.data.preferenciasAcessibilidade) || request.resource.data.preferenciasAcessibilidade.reduceMotion is bool)
          && (!('language' in request.resource.data.preferenciasAcessibilidade) || (request.resource.data.preferenciasAcessibilidade.language is map
            && request.resource.data.preferenciasAcessibilidade.language.keys().hasOnly(['mode', 'value'])
            && (!('mode' in request.resource.data.preferenciasAcessibilidade.language) || request.resource.data.preferenciasAcessibilidade.language.mode in ['system', 'pt-BR', 'en-US', 'es-ES'])
            && (!('value' in request.resource.data.preferenciasAcessibilidade.language) || request.resource.data.preferenciasAcessibilidade.language.value in ['pt-BR', 'en-US', 'es-ES']))));
    }

    function validDashboardPreferences() {
      return (!('dashboardCards' in request.resource.data) || (request.resource.data.dashboardCards is list && request.resource.data.dashboardCards.size() <= 10))
        && (!('dashboardCardsUpdatedAt' in request.resource.data) || request.resource.data.dashboardCardsUpdatedAt is string || request.resource.data.dashboardCardsUpdatedAt is timestamp);
    }

    function validAppModules() {
      return !('appModules' in request.resource.data)
        || (request.resource.data.appModules is map
          && request.resource.data.appModules.keys().hasOnly(['treino', 'dieta', 'progresso', 'evolucao', 'conquistas'])
          && (!('treino' in request.resource.data.appModules) || request.resource.data.appModules.treino == true)
          && (!('dieta' in request.resource.data.appModules) || request.resource.data.appModules.dieta is bool)
          && (!('progresso' in request.resource.data.appModules) || request.resource.data.appModules.progresso is bool)
          && (!('evolucao' in request.resource.data.appModules) || request.resource.data.appModules.evolucao is bool)
          && (!('conquistas' in request.resource.data.appModules) || request.resource.data.appModules.conquistas is bool));
    }

    function validExerciseLibraryPreferences() {
      return !('exerciseLibraryPreferences' in request.resource.data)
        || (request.resource.data.exerciseLibraryPreferences is map
          && request.resource.data.exerciseLibraryPreferences.keys().hasOnly(['favoritosExercicios', 'recentesExercicios', 'exerciciosPersonalizados'])
          && (!('favoritosExercicios' in request.resource.data.exerciseLibraryPreferences) || (request.resource.data.exerciseLibraryPreferences.favoritosExercicios is list && request.resource.data.exerciseLibraryPreferences.favoritosExercicios.size() <= 300))
          && (!('recentesExercicios' in request.resource.data.exerciseLibraryPreferences) || (request.resource.data.exerciseLibraryPreferences.recentesExercicios is list && request.resource.data.exerciseLibraryPreferences.recentesExercicios.size() <= 30))
          && (!('exerciciosPersonalizados' in request.resource.data.exerciseLibraryPreferences) || (request.resource.data.exerciseLibraryPreferences.exerciciosPersonalizados is list && request.resource.data.exerciseLibraryPreferences.exerciciosPersonalizados.size() <= 30)));
    }
    function validUserProfileValues() {
      return (!('name' in request.resource.data) || request.resource.data.name is string || request.resource.data.name == null)
        && (!('email' in request.resource.data) || request.resource.data.email is string || request.resource.data.email == null)
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string || request.resource.data.photoURL == null)
        && (!('dailyCalorieGoal' in request.resource.data) || (request.resource.data.dailyCalorieGoal is number && request.resource.data.dailyCalorieGoal >= 800 && request.resource.data.dailyCalorieGoal <= 8000))
        && (!('metaCalorias' in request.resource.data) || (request.resource.data.metaCalorias is number && request.resource.data.metaCalorias >= 800 && request.resource.data.metaCalorias <= 8000))
        && validMacroGoals()
        && validAccessibilityPreferences()
        && validDashboardPreferences()
        && validAppModules()
        && validExerciseLibraryPreferences()
        && (!('unidadePeso' in request.resource.data) || request.resource.data.unidadePeso in ['kg', 'lb'])
        && (!('avatarFrame' in request.resource.data) || request.resource.data.avatarFrame in ['plastic', 'wood', 'bronze', 'silver', 'gold', 'diamond'] || (request.resource.data.avatarFrame == 'boss' && isAdmin()))
        && (!('perfilPrivado' in request.resource.data) || request.resource.data.perfilPrivado is bool)
        && (!('compartilharEstatisticas' in request.resource.data) || request.resource.data.compartilharEstatisticas is bool)
        && (!('metaSemanal' in request.resource.data) || (request.resource.data.metaSemanal is number && request.resource.data.metaSemanal >= 1 && request.resource.data.metaSemanal <= 7))
        && (!('alturaCm' in request.resource.data) || request.resource.data.alturaCm == null || (request.resource.data.alturaCm is number && request.resource.data.alturaCm >= 100 && request.resource.data.alturaCm <= 250))
        && (!('metaPesoKg' in request.resource.data) || request.resource.data.metaPesoKg == null || (request.resource.data.metaPesoKg is number && request.resource.data.metaPesoKg >= 20 && request.resource.data.metaPesoKg <= 400))
        && (!('objetivo' in request.resource.data) || request.resource.data.objetivo in ['', 'Hipertrofia', 'Força', 'Emagrecimento', 'Saúde'])
        && (!('medidasHistorico' in request.resource.data) || (request.resource.data.medidasHistorico is list && request.resource.data.medidasHistorico.size() <= 50))
        && (!('fotosProgresso' in request.resource.data) || (request.resource.data.fotosProgresso is list && request.resource.data.fotosProgresso.size() <= 5));
    }

    function validNewUserProfile() {
      return request.resource.data.keys().hasOnly(userProfileFields()) && validUserProfileValues();
    }

    // Perfis antigos podem ter campos legados. Eles não bloqueiam a edição dos
    // campos atuais, mas o cliente não pode criar ou mudar campos fora da lista.
    function validUserProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(userProfileFields()) && validUserProfileValues();
    }

    function validRoutine() {
      return request.resource.data.keys().hasOnly(['userId', 'nome', 'descricao', 'horario', 'diasSemana', 'exercicios', 'criadoEm', 'ultimoTreinoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 1
        && request.resource.data.nome.size() <= 80
        && (!('descricao' in request.resource.data) || (request.resource.data.descricao is string && request.resource.data.descricao.size() <= 240))
        && (!('horario' in request.resource.data) || (request.resource.data.horario is string && (request.resource.data.horario == '' || request.resource.data.horario.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))))
        && (!('diasSemana' in request.resource.data) || (request.resource.data.diasSemana is list && request.resource.data.diasSemana.size() <= 7))
        && request.resource.data.exercicios is list
        && request.resource.data.exercicios.size() <= 60;
    }

    function validSession() {
      return request.resource.data.keys().hasOnly(['userId', 'rotinaId', 'nomeRotina', 'exercicios', 'volumeTotal', 'duracaoSegundos', 'checkinPreTreino', 'iniciadaEm', 'concluidoEm'])
        && request.resource.data.nomeRotina is string
        && request.resource.data.nomeRotina.size() <= 80
        && request.resource.data.exercicios is list
        && request.resource.data.exercicios.size() <= 60
        && (!('volumeTotal' in request.resource.data) || (request.resource.data.volumeTotal is number && request.resource.data.volumeTotal >= 0))
        && (!('duracaoSegundos' in request.resource.data) || (request.resource.data.duracaoSegundos is number && request.resource.data.duracaoSegundos >= 0 && request.resource.data.duracaoSegundos <= 86400));
    }

    function validWeight() {
      return request.resource.data.keys().hasOnly(['userId', 'pesoKg', 'registradoEm'])
        && request.resource.data.pesoKg is number
        && request.resource.data.pesoKg >= 20
        && request.resource.data.pesoKg <= 400;
    }

    function validFasting() {
      return !('jejum' in request.resource.data)
        || (request.resource.data.jejum is map
          && request.resource.data.jejum.keys().hasOnly(['ativo', 'protocolo', 'inicioJanela', 'fimJanela', 'diasSemana', 'treino', 'pausadoHoje'])
          && (!('ativo' in request.resource.data.jejum) || request.resource.data.jejum.ativo is bool)
          && (!('protocolo' in request.resource.data.jejum) || request.resource.data.jejum.protocolo in ['12:12', '14:10', '16:8', '18:6', '20:4', 'custom'])
          && (!('inicioJanela' in request.resource.data.jejum) || request.resource.data.jejum.inicioJanela is string)
          && (!('fimJanela' in request.resource.data.jejum) || request.resource.data.jejum.fimJanela is string)
          && (!('diasSemana' in request.resource.data.jejum) || (request.resource.data.jejum.diasSemana is list && request.resource.data.jejum.diasSemana.size() <= 7))
          && (!('treino' in request.resource.data.jejum) || request.resource.data.jejum.treino in ['jejum', 'alimentado', 'flexivel'])
          && (!('pausadoHoje' in request.resource.data.jejum) || request.resource.data.jejum.pausadoHoje is bool));
    }

    function validDiet() {
      return request.resource.data.keys().hasOnly(['userId', 'refeicoes', 'jejum', 'atualizadoEm'])
        && request.resource.data.refeicoes is list
        && request.resource.data.refeicoes.size() <= 12
        && validFasting();
    }

    function validPresence() {
      return request.resource.data.keys().hasOnly(['userId', 'email', 'name', 'page', 'online', 'lastSeen'])
        && request.resource.data.userId == request.auth.uid
        && (!('email' in request.resource.data) || request.resource.data.email is string && request.resource.data.email.size() <= 254)
        && (!('name' in request.resource.data) || request.resource.data.name is string && request.resource.data.name.size() <= 80)
        && (!('page' in request.resource.data) || request.resource.data.page is string && request.resource.data.page.size() <= 240)
        && (!('online' in request.resource.data) || request.resource.data.online is bool);
    }

    function validClientError() {
      return request.resource.data.keys().hasOnly(['userId', 'email', 'message', 'stack', 'page', 'url', 'userAgent', 'createdAt', 'expiresAt'])
        && request.resource.data.userId == request.auth.uid
        && (!('email' in request.resource.data) || request.resource.data.email is string && request.resource.data.email.size() <= 254)
        && (!('message' in request.resource.data) || request.resource.data.message is string && request.resource.data.message.size() <= 1000)
        && (!('stack' in request.resource.data) || request.resource.data.stack is string && request.resource.data.stack.size() <= 4000)
        && (!('page' in request.resource.data) || request.resource.data.page is string && request.resource.data.page.size() <= 240)
        && (!('url' in request.resource.data) || request.resource.data.url is string && request.resource.data.url.size() <= 500)
        && (!('userAgent' in request.resource.data) || request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500)
        // Teto de 1 ano evita que um cliente adulterado marque expiresAt
        // longe demais no futuro e escape da limpeza automática por TTL.
        && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt < request.time + duration.value(366, 'd'));
    }

    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && validNewUserProfile();
      allow update: if signedIn() && request.auth.uid == userId && validUserProfileUpdate();
    }

    match /treinos/{treinoId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && validRoutine();
      allow update: if ownsExisting() && ownsNew() && validRoutine();
    }

    match /sessoes/{sessaoId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && validSession();
      allow update: if false;
    }

    match /pesos/{pesoId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew() && validWeight();
      allow update: if ownsExisting() && ownsNew() && validWeight();
    }

    match /dietas/{dietaId} {
      allow get: if signedIn() && (dietaId == request.auth.uid || prepPartners(request.auth.uid, dietaId));
      allow list: if signedIn() && dietaId == request.auth.uid;
      allow delete: if ownsExisting() && dietaId == request.auth.uid;
      allow create: if ownsNew() && dietaId == request.auth.uid && validDiet();
      allow update: if ownsExisting() && ownsNew() && dietaId == request.auth.uid && validDiet();
    }

    match /presence/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn() && request.auth.uid == userId
        && validPresence();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /clientErrors/{errorId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && validClientError();
      allow update: if false;
    }
  }
}
