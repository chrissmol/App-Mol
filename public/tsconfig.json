{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [],
    "paths": { "@brand": ["./brands/mol.json"] }
  },
  "include": ["js/**/*.js", "js/types/global.d.ts", "js/types/vite-assets.d.ts"],
  "exclude": ["node_modules", "dist", "vendor", "e2e", "tests"]
}
